# Base de données PostgreSQL — une base Neon distincte par client
# Récupérée depuis le dashboard Neon après création du projet
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (à ajouter à l'étape suivante quand on branche l'authentification)
NEXTAUTH_SECRET="générer avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Clé de chiffrement des identifiants sensibles (module fiche bien / accès plateformes)
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Une clé différente par déploiement client. Si elle est perdue, les mots de passe
# stockés deviennent illisibles (il faudra les ressaisir).
ENCRYPTION_KEY="à générer, ne jamais commiter"
